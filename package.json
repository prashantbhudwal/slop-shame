    "@wxt-dev/module-svelte": "^2.0.4",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.3",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
