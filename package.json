{
  "name": "slop-shame",
  "description": "Rates every LinkedIn feed post with a Slop Index. Destroy the slop. Shame the slopper.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
